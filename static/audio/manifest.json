  "மலை": "/static/audio/ta/dac8606ce63d.mp3",
  "மீன்": "/static/audio/ta/ced28c49ba84.mp3",
  "யானை": "/static/audio/ta/9669a72df200.mp3",
  "ர": "/static/audio/ta/25e6e2046bf3.mp3",
  "ல": "/static/audio/ta/03a6c87e06ff.mp3",
  "வணக்கம்! நான் எரல் ஆந்தை. வா, தீவுகளுக்கு ஒரு சாகசப் பயணம் போகலாம்!": "/static/audio/ta/292060d6d662.mp3",
  "வணக்கம்! நான் எரல். தயவுசெய்து இந்தப் பக்கத்தை நிரப்புங்கள், பிறகு சாதனத்தைக் குழந்தையிடம் கொடுங்கள். நான் அவர்களைத் தீவுகள் வழியாக அழைத்துச் செல்வேன்.": "/static/audio/ta/a02bfe955ae7.mp3",
  "வாய்": "/static/audio/ta/f36d3aad0d6d.mp3",
  "வாவ், நீ நன்றாகச் செய்கிறாய்! அடுத்ததுக்குத் தயாரா?": "/static/audio/ta/4882fb24e3a0.mp3",
  "வீடு": "/static/audio/ta/96fb1cc5d3e7.mp3",
  "ஹூ ஹூ! இன்னொரு தீவு திறந்தது!": "/static/audio/ta/1cae1d464882.mp3"
 },
 "kn": {
  "ಅದ್ಭುತ! ಮುಂದಿನ ದ್ವೀಪದಲ್ಲಿ ಏನಿದೆ ನೋಡೋಣ.": "/static/audio/kn/3c7a78d7b8de.mp3",
  "ಇದು ನಿಜವಾದ ಪದವೇ ಅಥವಾ ಏಲಿಯನ್ ಪದವೇ?": "/static/audio/kn/d4958e7963e2.mp3",
  "ಎರಡರಲ್ಲಿ ದೊಡ್ಡ ಸಂಖ್ಯೆಯನ್ನು ಬೇಗನೆ ಒತ್ತು!": "/static/audio/kn/169e4de1a65e.mp3",
  "ಎರಡು ಪದಗಳನ್ನು ಕೇಳು. ಅವುಗಳಿಗೆ ಪ್ರಾಸ ಇದೆಯೇ?": "/static/audio/kn/b2487628c33c.mp3",
  "ಕ": "/static/audio/kn/f79c88a36312.mp3",
  "ಕಲ್ಲು": "/static/audio/kn/4f7ec52a6f21.mp3",
  "ಕಾಡು": "/static/audio/kn/370b684cc2ff.mp3",
  "ಕಾಣುವ ಪ್ರತಿಯೊಂದನ್ನೂ ಬೇಗನೆ ಒತ್ತು!": "/static/audio/kn/c0139d4ffb43.mp3",
  "ಕಾಲು": "/static/audio/kn/2b1f3b62bbdc.mp3",
  "ಕೈ": "/static/audio/kn/cd8f9d0a0663.mp3",
  "ಕೊನೆ": "/static/audio/kn/1e661650b998.mp3",
  "ಚುಕ್ಕೆಗಳು ಸ್ವಲ್ಪ ಹೊತ್ತು ಕಾಣುತ್ತವೆ. ಎಷ್ಟು ಇದ್ದವು? ಸಂಖ್ಯೆಯನ್ನು ಒತ್ತು!": "/static/audio/kn/098c61e8c842.mp3",
  "ಚೆಂಡು": "/static/audio/kn/4a415bb7a73b.mp3",
  "ಟ": "/static/audio/kn/7bbf01394530.mp3",
  "ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ! ಮುಂದಿನ ದ್ವೀಪಕ್ಕೆ ಹಾರೋಣ!": "/static/audio/kn/66ef415b2982.mp3",
  "ದ": "/static/audio/kn/0b432d8f3130.mp3",
  "ನಕ್ಷತ್ರ ಕಂಡರೆ ಒತ್ತು. ಮೋಡ ಕಂಡರೆ ಒತ್ತಬೇಡ!": "/static/audio/kn/e8f9095d3f6d.mp3",
  "ನಮಸ್ಕಾರ! ನಾನು ಎರಲ್ ಗೂಬೆ. ಬಾ, ದ್ವೀಪಗಳ ಸಾಹಸ ಯಾತ್ರೆಗೆ ಹೋಗೋಣ!": "/static/audio/kn/2ebbf14682db.mp3",
  "ನಮಸ್ಕಾರ! ನಾನು ಎರಲ್. ದಯವಿಟ್ಟು ಈ ಪುಟವನ್ನು ಭರ್ತಿ ಮಾಡಿ, ನಂತರ ಸಾಧನವನ್ನು ಮಗುವಿಗೆ ಕೊಡಿ. ನಾನು ಅವರನ್ನು ದ್ವೀಪಗಳ ಮೂಲಕ ಕರೆದೊಯ್ಯುತ್ತೇನೆ.": "/static/audio/kn/5b5333d96f2d.mp3",
  "ನಾಯಿ": "/static/audio/kn/c35b51aef68c.mp3",
  "ನೀನು ಎಲ್ಲಾ ದ್ವೀಪಗಳನ್ನೂ ಮುಗಿಸಿದೆ! ನೀನು ಒಂದು ನಕ್ಷತ್ರ!": "/static/audio/kn/dd63177042f1.mp3",
  "ನೀನು ನಿಜವಾದ ಪದ ಮಾಂತ್ರಿಕ! ಮುಂದೆ ಹೋಗೋಣ!": "/static/audio/kn/35ab73295472.mp3",
  "ನೀರು": "/static/audio/kn/17ac5d37f16c.mp3",
  "ನೋಡು, ಕೇಳು. ನಂತರ ಪ್ರಾಣಿಗಳನ್ನು ಅದೇ ಕ್ರಮದಲ್ಲಿ ಒತ್ತು!": "/static/audio/kn/49a1d9b022d5.mp3",
  "ಪ": "/static/audio/kn/614364468740.mp3",
  "ಪದವನ್ನು ಕೇಳಿ, ಅಕ್ಷರಗಳನ್ನು ಸರಿಯಾದ ಕ್ರಮದಲ್ಲಿ ಒತ್ತು.": "/static/audio/kn/6eff8c3b10db.mp3",
  "ಪದವನ್ನು ಕೇಳಿ, ಅದರ ಚಿತ್ರವನ್ನು ಬೇಗನೆ ಒತ್ತು!": "/static/audio/kn/7cc97d69b863.mp3",
