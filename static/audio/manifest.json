 "hi": {
  "आँख": "/static/audio/hi/43f9bb94d19b.mp3",
  "आम": "/static/audio/hi/cdae1a2d4904.mp3",
  "आवाज़ सुनो, फिर वह अक्षर टैप करो जिसकी यह आवाज़ है।": "/static/audio/hi/5d1ba8821e65.mp3",
  "कलम": "/static/audio/hi/8ef232ac73d3.mp3",
  "किताब": "/static/audio/hi/a37a10fc2183.mp3",
  "क्या यह असली शब्द है या एलियन शब्द?": "/static/audio/hi/00a7ba33c179.mp3",
  "ख": "/static/audio/hi/65ddeee24bb6.mp3",
  "खाना": "/static/audio/hi/0a0001279668.mp3",
  "गाना": "/static/audio/hi/5509af018f45.mp3",
  "गेंद": "/static/audio/hi/df02e2973528.mp3",
  "घ": "/static/audio/hi/f856ef66471b.mp3",
  "घर": "/static/audio/hi/9a8c977760d3.mp3",
  "चोर": "/static/audio/hi/3f142afb7e36.mp3",
  "जितने भी दिखें, सब पर जल्दी से टैप करो!": "/static/audio/hi/2957fea29e39.mp3",
  "तारा दिखे तो टैप करो। बादल दिखे तो टैप मत करो!": "/static/audio/hi/28a9ec097063.mp3",
  "तुम सच में शब्द जादूगर हो! आगे चलें!": "/static/audio/hi/7019a85e2bc8.mp3",
  "तुमने सारे द्वीप पूरे कर लिए! तुम एक सितारा हो!": "/static/audio/hi/34add77c5e9d.mp3",
  "द": "/static/audio/hi/9338481f4fbb.mp3",
  "दाल": "/static/audio/hi/1c04939450bf.mp3",
  "दिल्ली": "/static/audio/hi/bffa8816e940.mp3",
  "दूध": "/static/audio/hi/b94363af162a.mp3",
  "देखो और सुनो। फिर जानवरों को उसी क्रम में टैप करो!": "/static/audio/hi/796776eada64.mp3",
  "दो शब्द सुनो। क्या उनकी तुक मिलती है?": "/static/audio/hi/0d8dfe1a6fae.mp3",
  "दोनों में से बड़ी संख्या पर जल्दी से टैप करो!": "/static/audio/hi/75e64cc21e64.mp3",
  "नमस्ते! मैं एरल उल्लू हूँ। चलो द्वीपों के सफ़र पर चलें!": "/static/audio/hi/573f973f8412.mp3",
  "नमस्ते! मैं एरल हूँ। कृपया यह पेज भरें, फिर डिवाइस बच्चे को दें। मैं उन्हें द्वीपों की सैर कराऊँगा।": "/static/audio/hi/94f02d6a76b8.mp3",
  "नाक": "/static/audio/hi/c1cbe68d156e.mp3",
  "नाम": "/static/audio/hi/5f34e41ba386.mp3",
  "प": "/static/audio/hi/da51f487a976.mp3",
  "पानी": "/static/audio/hi/c5dab16039df.mp3",
  "पेड़": "/static/audio/hi/9676ee0ddb1c.mp3",
  "फूल": "/static/audio/hi/64b4e9f9705c.mp3",
  "ब": "/static/audio/hi/ab04fe477e1e.mp3",
  "बहुत खूब! एक गहरी साँस लो, फिर खेलते हैं।": "/static/audio/hi/c9e0c159a9c5.mp3",
  "बहुत बढ़िया! चलो अगले द्वीप पर उड़ते हैं!": "/static/audio/hi/12ea3ea1da1a.mp3",
  "बादल": "/static/audio/hi/f7b67be97f56.mp3",
  "बाल": "/static/audio/hi/8aea7446dda8.mp3",
  "बिंदु थोड़ी देर के लिए दिखेंगे। कितने थे? सही संख्या पर टैप करो!": "/static/audio/hi/30c43e3cdc74.mp3",
  "बिल्ली": "/static/audio/hi/b1a109346e41.mp3",
  "म": "/static/audio/hi/f9b4db2a7849.mp3",
  "मछली": "/static/audio/hi/65b968e2186e.mp3",
  "मोर": "/static/audio/hi/f5d359154055.mp3",
  "रानी": "/static/audio/hi/5ac9b369d545.mp3",
  "रोटी": "/static/audio/hi/2b2d45de61f1.mp3",
  "ल": "/static/audio/hi/521cf26301e6.mp3",
  "वाह, तुम कमाल कर रहे हो! अगले के लिए तैयार?": "/static/audio/hi/c0b2c2a23ab1.mp3",
  "शब्द सुनो, फिर अक्षरों को सही क्रम में टैप करो।": "/static/audio/hi/28b6b1e5d969.mp3",
  "शब्द सुनो, फिर उसकी तस्वीर पर जल्दी से टैप करो!": "/static/audio/hi/a3278d6679b9.mp3",
  "शानदार! चलो देखें अगले द्वीप पर क्या है।": "/static/audio/hi/dd4b14feba9c.mp3",
  "स": "/static/audio/hi/ce0c034e0ab5.mp3",
  "सूरज": "/static/audio/hi/5f32d9179465.mp3",
  "सेब": "/static/audio/hi/44e6c801844a.mp3",
  "हाथ": "/static/audio/hi/a0b414fa93e2.mp3",
  "हू हू! एक और द्वीप खुल गया!": "/static/audio/hi/fee58aed04be.mp3"
